{
  "name": "@okey/mobil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Okey Salonu Android uygulaması: React + Vite arayüzü, Capacitor ile Android'e paketlenir.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p . && vite build",
    "onizle": "vite preview --host",
    "android": "npm run build && cap sync android && cap open android",
    "sync": "npm run build && cap sync android",
    "test": "vitest run --root ../.. packages/mobil",
    "simgeler": "node betikler/simgeleri-uret.mjs",
    "ekran": "node betikler/ekran-goruntusu.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capgo/native-purchases": "8.9.6",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@okey/kurallar": "*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "1.59.1",
    "vite": "6.4.5"
  }
}
