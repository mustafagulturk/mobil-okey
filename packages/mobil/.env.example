# Bu dosyayı .env adıyla kopyalayıp düzenleyin. Vite sadece VITE_ ile başlayanları uygulamaya verir.

# Oyun sunucusunun WebSocket adresi. Boşsa: tarayıcıda ws://<bilgisayar>:8080/ws,
# Android emülatöründe ws://10.0.2.2:8080/ws kullanılır.
VITE_SUNUCU_URL=

# AdMob ödüllü reklam birimi kimliği. Boşsa Google'ın test birimi kullanılır.
VITE_ADMOB_ODULLU=
